.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
tests/.generated-evaluation-harness/
.env
.env.*
!frontend/.env.example

# Next.js frontend build and dependency artefacts.
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/tsconfig.tsbuildinfo

# Local model and experiment caches must not be committed accidentally.
.cache/
artifacts/models/
artifacts/stage-7/
artifacts/deployment/
experiments/training/
artifacts/diagnostics/*
!artifacts/diagnostics/lora-lifecycle-adapter/
!artifacts/diagnostics/lora-lifecycle-adapter/README.md
!artifacts/diagnostics/lora-lifecycle-adapter/adapter_config.json
!artifacts/diagnostics/lora-lifecycle-adapter/adapter_model.safetensors

# Preserve the small, immutable Step 7 CUDA evidence bundles while continuing
# to ignore model adapters and other disposable diagnostic artefacts.
!artifacts/diagnostics/inference-harness-cuda/
artifacts/diagnostics/inference-harness-cuda/*
!artifacts/diagnostics/inference-harness-cuda/*/
!artifacts/diagnostics/inference-harness-cuda/*/manifest.json
!artifacts/diagnostics/inference-harness-cuda/*/prompts.jsonl
!artifacts/diagnostics/inference-harness-cuda/*/responses.jsonl
