{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:chatgnt:schema:heldout-freeze-bundle:v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","bundle_id","status","reviewed_protocol_manifest_sha256","protocol_aggregate_sha256","heldout_prompts_sha256","prompt_reviews_sha256","replacement_log_sha256","source_identities_sha256","source_records_sha256","withheld_domain_checks_sha256","semantic_review_artifact_sha256","authoring_schedule_sha256","authoring_ledger_entry_count","authoring_ledger_final_entry_sha256","authoring_ledger_reviewer_identity","authoring_ledger_attestation","authoring_ledger_attested_at_utc","pair_order_schedule_sha256","accepted_prompt_count","accepted_audit_count","rejected_candidate_count","withheld_domain_check_count","pair_order_count","source_identity_ids","model_training_started","heldout_generation_started","frozen_at_utc"],
  "properties": {
    "schema_version":{"const":1},
    "bundle_id":{"type":"string","pattern":"^heldout-freeze-v1-[A-Za-z0-9._-]+$"},
    "status":{"const":"frozen"},
    "reviewed_protocol_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "protocol_aggregate_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "heldout_prompts_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "prompt_reviews_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "replacement_log_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_identities_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_records_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "withheld_domain_checks_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "semantic_review_artifact_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "authoring_schedule_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "authoring_ledger_entry_count":{"type":"integer","minimum":60},
    "authoring_ledger_final_entry_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "authoring_ledger_reviewer_identity":{"type":"string","pattern":"\\S"},
    "authoring_ledger_attestation":{"const":"I reviewed the complete append-only authoring ledger and attest that it contains every candidate attempt, including rejected attempts, in actual authoring order."},
    "authoring_ledger_attested_at_utc":{"type":"string","format":"date-time"},
    "pair_order_schedule_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "accepted_prompt_count":{"const":60},
    "accepted_audit_count":{"const":6},
    "rejected_candidate_count":{"type":"integer","minimum":0},
    "withheld_domain_check_count":{"const":15},
    "pair_order_count":{"const":60},
    "source_identity_ids":{"type":"array","minItems":7,"uniqueItems":true,"items":{"type":"string","pattern":"^source-v1-[A-Za-z0-9._-]+$"}},
    "model_training_started":{"const":false},
    "heldout_generation_started":{"const":false},
    "frozen_at_utc":{"type":"string","format":"date-time"}
  }
}
