{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:chatgnt:schema:evaluation-generation-manifest:v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","manifest_id","run_id","source_harness_manifest_path","source_harness_manifest_sha256","source_harness_prompts_sha256","source_harness_responses_sha256","source_harness_inspection_sha256","heldout_records_sha256","run_configuration_sha256","systems","scheduled_attempt_count","attempts_sha256","run_records_sha256"],
  "properties":{
    "schema_version":{"const":1},
    "manifest_id":{"type":"string","pattern":"^evaluation-generation-manifest-v1-[A-Za-z0-9._-]+$"},
    "run_id":{"type":"string","pattern":"\\S"},
    "source_harness_manifest_path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).*manifest\\.json$"},
    "source_harness_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_harness_prompts_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_harness_responses_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_harness_inspection_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "heldout_records_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "run_configuration_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "systems":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/system"}},
    "scheduled_attempt_count":{"const":240},
    "attempts_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "run_records_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "$defs":{
    "system":{"type":"object","additionalProperties":false,
      "required":["system_id","adapter_enabled","prompt_asset_sha256","model_sha256","generation_config_sha256","adapter_sha256","system_configuration_sha256"],
      "properties":{
        "system_id":{"enum":["A","B","C","D"]},"adapter_enabled":{"type":"boolean"},
        "prompt_asset_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "model_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "generation_config_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "adapter_sha256":{"oneOf":[{"type":"null"},{"type":"string","pattern":"^[0-9a-f]{64}$"}]},
        "system_configuration_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    }
  }
}
