{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chatgnt:schema:evaluation-protocol-manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "protocol_id", "protocol_normative_sha256", "assets", "aggregate_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"const": "chatgnt-evaluation-manifest-v1"},
    "protocol_id": {"const": "chatgnt-evaluation-v1"},
    "protocol_normative_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "\\S"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "aggregate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
