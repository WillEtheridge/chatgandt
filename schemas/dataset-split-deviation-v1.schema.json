{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chatgnt:schema:dataset-split-deviation:v1",
  "title": "ChatG&T dataset split deviation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_schema_version", "deviation_id", "dataset_contract_id", "candidates_sha256", "train_sha256", "validation_sha256", "pilot_sha256", "expected_counts", "achieved_counts", "reason", "affected_scenario_ids", "rationale", "approved_by", "approved_at_utc"],
  "properties": {
    "record_schema_version": {"const": 1},
    "deviation_id": {"const": "dataset-split-deviation-v1"},
    "dataset_contract_id": {"const": "chatgnt-dataset-v1"},
    "candidates_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "train_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pilot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_counts": {"$ref": "#/$defs/counts"},
    "achieved_counts": {"$ref": "#/$defs/counts"},
    "reason": {"const": "scenario_group_indivisibility"},
    "affected_scenario_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^scenario-[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "rationale": {"type": "string", "pattern": "\\S"},
    "approved_by": {"type": "string", "pattern": "\\S"},
    "approved_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "$defs": {
    "family_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "pilot"],
      "properties": {"train": {"type": "integer", "minimum": 0}, "validation": {"type": "integer", "minimum": 0}, "pilot": {"type": "integer", "minimum": 0}}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "pilot", "per_intent_family"],
      "properties": {
        "train": {"type": "integer", "minimum": 0},
        "validation": {"type": "integer", "minimum": 0},
        "pilot": {"type": "integer", "minimum": 0},
        "per_intent_family": {
          "type": "object",
          "additionalProperties": false,
          "required": ["advice_decision_support", "explanation_technical_understanding", "low_stakes_emotional_support", "creative_generation", "short_form_transformation"],
          "properties": {
            "advice_decision_support": {"$ref": "#/$defs/family_counts"},
            "explanation_technical_understanding": {"$ref": "#/$defs/family_counts"},
            "low_stakes_emotional_support": {"$ref": "#/$defs/family_counts"},
            "creative_generation": {"$ref": "#/$defs/family_counts"},
            "short_form_transformation": {"$ref": "#/$defs/family_counts"}
          }
        }
      }
    }
  }
}
