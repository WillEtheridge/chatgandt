{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_key", "decision", "rationale"],
        "properties": {
          "review_key": {"type": "string"},
          "decision": {"enum": ["no_concern", "review_flag"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
